{
	"compilerOptions": {
		"target": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "dom"],
		"types": ["@webgpu/types", "vite/client", "node"],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"checkJs": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "bench", "vite.config.ts"],
	"exclude": ["bench/runs"]
}
